<!DOCTYPE html>
<html lang="en" data-theme="dark" data-ornament="signal">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% if page.url == '/' %}<meta name="google-site-verification" content="-UW8DUFq4IJm1JwqhuUIZkI5fIlOCjhz6Ysfs9u8JHU">{% endif %}
<meta name="description" content="{{ description }}">
<meta property="og:title" content="{{ ogtitle or title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="https://snackdriven.com{{ page.url }}">
<meta property="og:type" content="{{ ogtype or 'website' }}">
<meta property="og:image" content="https://snackdriven.com{{ ogimage or '/assets/social/site.png' }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ ogimagealt or 'snackdriven.com: debugging, useful tools, and a little weirdness.' }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://snackdriven.com{{ ogimage or '/assets/social/site.png' }}">
<link rel="canonical" href="https://snackdriven.com{{ page.url }}">
<link rel="alternate" type="application/atom+xml" title="snackdriven.com — the log" href="/feed.xml">
<meta name="theme-color" content="#15131B">
<link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
<title>{{ title }}{% if isPost %} · snackdriven.com{% endif %}</title>
<link rel="stylesheet" href="/assets/site.css">
{% if blogcss %}<link rel="stylesheet" href="/assets/blog.css">{% endif %}
<script defer src="/assets/site.js"></script>
<script defer src="/assets/repo-shortcut.js"></script>
{% if isPost %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | jsonDump | safe }},
  "description": {{ description | jsonDump | safe }},
  "datePublished": "{{ date | ymd }}",
  "dateModified": "{{ (updated or date) | ymd }}",
  "author": { "@type": "Person", "name": "Kayla Young", "alternateName": "Kayla Gilbert", "url": "https://snackdriven.com/" },
  "url": "https://snackdriven.com{{ page.url }}",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://snackdriven.com{{ page.url }}" }
}
</script>
{% endif %}
<link rel="stylesheet" href="/assets/brand/component-appearance-tokens.css">
<link rel="stylesheet" href="/assets/brand-v2.css">
</head>
<body class="{% if isPost %}blog-post{% elif page.url == '/' %}blog-index{% else %}blog-page{% endif %}">
<a href="#main-content" class="skip-link">Skip to content</a>
<div class="shell">
{% include "topbar.njk" %}
<main id="main-content">
{{ content | safe }}
</main>
{% include "site-footer.njk" %}
</div>
</body>
</html>
